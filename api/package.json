{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "imports": {
    "#models": "./src/db/models/index.ts"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.ts",
    "dev": "node --watch --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env src/db/migrate.ts up",
    "db:migrate:undo": "node --env-file=.env src/db/migrate.ts down",
    "db:migrate:status": "node --env-file=.env src/db/migrate.ts pending",
    "db:migrate:create": "node --env-file=.env src/db/migrate.ts create",
    "set-password": "node --env-file=.env src/db/scripts/set-password.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@graphql-tools/merge": "^10.0.6",
    "bcryptjs": "^3.0.3",
    "graphql": "^16.14.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
}
